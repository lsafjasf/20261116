{
  "name": "stable-sprite-atlas-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Incremental sprite atlas packer with stable coordinates and lossless reload",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test",
    "test:default": "node --test --test-name-pattern='default parameter group'",
    "test:boundary": "node --test --test-name-pattern='boundary parameter group'",
    "test:exception": "node --test --test-name-pattern='exception parameter group'",
    "report": "node scripts/incremental-report.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
